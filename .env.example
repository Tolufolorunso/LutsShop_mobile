# =============================================================================
# LUTShop Mobile - Environment Variables
# Copy this file to `.env` and fill in your values
# =============================================================================

# Backend API Base URL
# - Android Emulator: http://10.0.2.2:3000
# - iOS Simulator / Web: http://localhost:3000
# - Physical Mobile Device (Expo Go): http://<YOUR_LOCAL_IP>:3000 (e.g. http://192.168.1.50:3000)
# - Production: https://lutshop-production.onrender.com
EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:3000

# Google OAuth 2.0 Credentials (Optional - Demo Mode works without these)
# Web Client ID (used by Expo Go and web):
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Android Client ID (from Google Cloud Console OAuth 2.0 credentials):
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=

# iOS Client ID (from Google Cloud Console OAuth 2.0 credentials):
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
